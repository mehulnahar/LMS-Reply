{
  "name": "lms-reply",
  "version": "1.0.0",
  "description": "LMS Reply - Learning Management System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node src/config/migrate.js",
    "test": "jest --passWithNoTests --forceExit --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "build:check": "echo 'Build check passed'",
    "build": "cd client && npm install && npx vite build"
  },
  "keywords": [
    "lms",
    "learning",
    "education"
  ],
  "author": "Mehul Nahar",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.0.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.js"
    ],
    "testTimeout": 30000
  }
}
